generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String            @id @default(cuid())
  name           String?
  email          String?           @unique
  phone          String?
  passwordHash   String?
  role           String            @default("MEMBER") // ADMIN, LEADER, MEMBER
  isApproved     Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  participations EventParticipant[]
  souls          Soul[]
  testimonies    Testimony[]
  leaderId       String?
  leader         User?             @relation("UserToLeader", fields: [leaderId], references: [id])
  members        User[]            @relation("UserToLeader")
}

model Event {
  id                String            @id @default(cuid())
  eventCode         String?           @unique
  status            String            @default("PENDING")
  title             String
  date              DateTime
  location          String
  googleMapsLink    String?
  wazeLink          String?
  whatsappLink      String?
  whatsappGroupLink String?
  meetingPoint      String?
  remarks           String?
  leaderName        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  participants      EventParticipant[]
  souls             Soul[]
}

model EventParticipant {
  id          String   @id @default(cuid())
  userId      String
  eventId     String
  isPresent   Boolean  @default(false)
  checkedInAt DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}

model EvangelismRequest {
  id          String   @id @default(cuid())
  name        String
  contactInfo String
  area        String
  details     String?
  status      String   @default("PENDING") // PENDING, CONTACTED, RESOLVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemSettings {
  id               String   @id @default("singleton")
  smtpHost         String?
  smtpPort         Int?
  smtpUser         String?
  smtpPass         String?
  prayerEmailTargets String? // comma separated list
  whatsappTemplate String?  @default("Hi, I'm interested in the event...")
  rolePermissions  Json?    @default("{}")
  updatedAt        DateTime @updatedAt
}

model Soul {
  id        String   @id @default(cuid())
  userId    String
  name      String
  phone     String
  prayed    Boolean  @default(false)
  healed    Boolean  @default(false)
  requestedPrayer Boolean @default(false)
  prayerEmailSent Boolean @default(false)
  prayerNeeds     String?
  prayerNeedsAudioUrl String?
  remarks         String?
  remarksAudioUrl String?
  eventId         String?
  isPriority      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event           Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
}

model Testimony {
  id        String   @id @default(cuid())
  userId    String
  name      String
  content   String?
  audioUrl  String?
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
